MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-host>/<db_name>
DB_NAME=farmer_assistant

JWT_SECRET_KEY=<generate-a-long-random-secret>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=7200

CLOUDINARY_CLOUD_NAME=<your-cloudinary-cloud-name>
CLOUDINARY_API_KEY=<your-cloudinary-api-key>
CLOUDINARY_API_SECRET=<your-cloudinary-api-secret>

# Primary Groq key is required; _2/_3/_4 are optional extras the backend
# rotates to automatically if the primary hits its daily rate limit.
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY_2=<optional-second-groq-key>
GROQ_API_KEY_3=<optional-third-groq-key>
GROQ_API_KEY_4=<optional-fourth-groq-key>

NVIDIA_API_KEY=<your-nvidia-api-key>
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

PINECONE_API_KEY=<your-pinecone-api-key>
PINECONE_INDEX_NAME=farmer-assistant
PINECONE_ENVIRONMENT=us-east-1

GNEWS_API_KEY=<your-gnews-api-key>
GNEWS_BASE_URL=https://gnews.io/api/v4
NEWSDATA_API_KEY=<your-newsdata-api-key>
CURRENTS_API_KEY=<your-currents-api-key>

AGMARKNET_API_KEY=<your-data.gov.in-api-key>
AGMARKNET_API_URL=https://api.data.gov.in/resource/35985678-0d79-46b4-9ed6-6f13308a1d24

ICAR_API_KEY=<your-data.gov.in-api-key>
ICAR_API_BASE_URL=https://api.data.gov.in/catalog/icar-publication-repository
ICAR_KRISHIKOSH_URL=https://krishikosh.egranth.ac.in
ICAR_KRISHI_URL=https://krishi.icar.gov.in
ICAR_SYNC_SCHEDULE_DAY=sunday
ICAR_SYNC_SCHEDULE_HOUR=0

OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

IP_API_BASE_URL=http://ip-api.com/json

TWILIO_ACCOUNT_SID=<your-twilio-account-sid>
TWILIO_AUTH_TOKEN=<your-twilio-auth-token>
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

CRON_SECRET=<generate-a-long-random-secret>

APP_NAME=Farmer Assistant
DEBUG=True
FRONTEND_URL=http://localhost:5173

AGENT_SCHEDULE_HOUR=6
AGENT_SCHEDULE_MINUTE=0
